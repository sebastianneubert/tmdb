TMDB_API_KEY=your_api_key_here
# use the tmdb providers command to get a list of available providers for your region
PROVIDERS="Netflix,Disney Plus,Wow,Rtl+,AmazonPrime"
REGION=DE
MIN_RATING=7.5
MIN_VOTES=1000
API_TIMEOUT_SECONDS=20
# hide movies with an age rating above this age (uses the ratings of REGION, e.g. FSK for DE), 0 = off
# MAX_AGE=12
# with MAX_AGE: also show movies that have no age rating in REGION
# INCLUDE_UNRATED=true
# DEBUG=true
